"use client";

import { useEffect } from "react";

export default function GlobalError({
  error,
  unstable_retry,
}: {
  error: Error & { digest?: string };
  unstable_retry: () => void;
}) {
  useEffect(() => {
    console.error(error);
  }, [error]);

  return (
    <html lang="en">
      <body className="flex flex-col items-center justify-center min-h-screen bg-background text-foreground font-sans p-6 text-center">
        <div className="max-w-md w-full border border-border-mute bg-surface rounded-lg p-8 shadow-sm">
          <h2 className="text-xl font-bold mb-4 text-red-600 dark:text-red-400">
            Something went wrong!
          </h2>
          <p className="text-sm text-text-muted mb-6">
            An unexpected error occurred in the application structure.
          </p>
          <button
            onClick={() => unstable_retry()}
            className="w-full rounded bg-foreground px-4 py-2 text-xs font-semibold text-background hover:bg-foreground/90 transition-colors cursor-pointer"
          >
            Try again
          </button>
        </div>
      </body>
    </html>
  );
}
